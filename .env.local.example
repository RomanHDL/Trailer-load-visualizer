# MongoDB Atlas connection string
# 1. Go to https://cloud.mongodb.com
# 2. Cluster -> Connect -> Drivers -> Copy URI
# 3. Replace <password> and add your db name (e.g. /trailer)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/trailer?retryWrites=true&w=majority

# Largo total del trailer en metros (configurable)
NEXT_PUBLIC_TRAILER_LENGTH=15.9
